# Copy to .env.local (which git ignores) and fill in. Vite reads these at build
# time, so run `npm run cap:sync` after changing them.

# Leaderboard server address for the native app and for deployed web builds.
# In `npm run dev` this can stay empty: the dev server proxies /api to localhost:8787.
VITE_API_URL=

# RevenueCat public SDK keys (Project settings > API keys). Without them the
# native app shows no prices and sells nothing.
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=

# Your AdMob rewarded ad unit ids. Left empty, Google's sample units are used,
# which only serve test ads.
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_REWARDED_ANDROID=

# Set to 1 to use the pretend store and ads inside the native app, for trying
# it on a device before the accounts exist. Never ship a build with this set.
VITE_SIMULATE_STORE=
